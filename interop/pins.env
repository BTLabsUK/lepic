# Public upstream sources the interop stack builds from, pinned by commit (ADR 0009).
# Sourced by the scripts in this directory.

EPIC_REPO=https://github.com/EpicCash/epic
EPIC_TAG=v4.0.4
EPIC_COMMIT=9d022b1d521d3f705532e12ab77e0a429f6fde1f

EPIC_WALLET_REPO=https://github.com/EpicCash/epic-wallet
EPIC_WALLET_TAG=v4.0.2
EPIC_WALLET_COMMIT=465d499f01aad7e570b6cc220d52c6bfcf6a9a44

# The relay has no release tags. Its epicboxlib checker builds against the epic-wallet commit that
# this relay commit records as a submodule.
EPICBOX_REPO=https://github.com/EpicCash/epic-epicbox-docker
EPICBOX_COMMIT=b5f1954be92772d9703029ddfcdbac72c84c7570

# Toolchains: the reference code pins 1.89.0 in its rust-toolchain.toml, LEPIC pins 1.99.0.
REFERENCE_RUST=1.89.0
LEPIC_RUST=1.99.0
