+    /// The messages waiting for `address`, oldest first, as `(from, str, signature, txid)`.
+    /// Added for the `cli-0.6.0` upgrade fixture generator only.
+    pub fn waiting(
+        &self,
+        address: &EpicboxAddress,
+    ) -> Vec<(String, String, String, Option<String>)> {
+        let state = self.lock();
+        let queue = state.queue_name(&address.key_text(), Some(address.domain().as_str()));
+        state
+            .messages
+            .iter()
+            .filter(|m| m.queue == queue && !m.made)
+            .map(|m| {
+                (
+                    m.from.clone(),
+                    m.str.clone(),
+                    m.signature.clone(),
+                    m.txid.clone(),
+                )
+            })
+            .collect()
+    }
